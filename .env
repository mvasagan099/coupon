# ============================================================
# CouponVault – Frontend Environment Variables
# NEVER commit this file to git. Use .env.example as template.
# ============================================================

# Supabase — rotate these keys immediately if they were ever committed
# Find them at: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# Razorpay — Key ID only (never commit the Key Secret here)
# Find at: Razorpay Dashboard → Settings → API Keys
VITE_RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID

# PayPal — Client ID only (never commit the Client Secret here)
# Find at: developer.paypal.com → My Apps → App Details
VITE_PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
