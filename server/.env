# ============================================================
# CouponVault Server – Environment Variables
# NEVER commit this file to git. Use .env.example as template.
# ============================================================

# Supabase — use the SERVICE ROLE key (not the anon key)
# Find it at: Supabase Dashboard → Settings → API → service_role
SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Inter-platform API key — generate with:
#   node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
# Must be at least 64 random hex characters. NEVER use a guessable value.
API_KEY=REPLACE_WITH_64_CHAR_HEX_VALUE

PORT=4000
